# /etc/inittab for MCOS (busybox init).
#
# MCOS has no login: the panel IS the user interface and owns the screen. We
# ship our own inittab (no "# GENERIC_SERIAL" marker, so Buildroot's getty fixup
# leaves it alone) but KEEP Buildroot's standard sysinit mount block -- dropping
# it left /proc, /sys, /run and /tmp unmounted (broke nodeId + sshd lock files).
#
# Format: <id>:<runlevels>:<action>:<process>

# Mount core filesystems (proc, then everything in /etc/fstab) before anything
# else. /run is a fresh tmpfs after "mount -a", so (re)create the dirs we need.
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock /run/mcos
::sysinit:/bin/hostname -F /etc/hostname

# Start the daemon and services.
::sysinit:/etc/init.d/rcS

# The panel gets its own foreground virtual terminal. Boot logs remain separate,
# while mcos-launch switches to this terminal and starts the fbterm-backed TUI.
tty2::respawn:/usr/bin/mcos-launch

# Power management / shutdown.
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
::restart:/sbin/init
