#!/bin/sh
# MCOS startup script — run after all other init scripts.
#
# MCOS keeps its first-boot logic in the daemon, not here: mcosd loads the
# config, compares a hardware fingerprint (MAC-based) against the one stored at
# setup time, and flips setupComplete=false when the disk/USB has been moved to
# a new PC. The panel then shows the setup wizard. This script only has to
# mount persistent storage, make sure a config exists, and launch the daemon
# and panel.

MCOS_DATA=/data
MCOSD=/usr/bin/mcosd
PANEL=/usr/bin/mcos-panel
SOCK=unix:///run/mcos/mcosd.sock

# Kalici depolama ve ilk yapilandirma artik S03mcosdata icinde.
#
# NEDEN TASINDI: acilis animasyonunun (S04splash) "animasyon kapali mi" ayarini
# okuyabilmesi icin /data'nin ONDAN ONCE bagli olmasi gerekiyor. Bu betik
# rcS'in EN SONUNDA calisiyor; oraya bagimli kalinsaydi animasyon da en sona
# kalirdi - kullanicinin sikayet ettigi siyah ekran penceresi tam olarak oydu.
#
# Cagri burada duruyor cunku "S99mcos restart" tek basina da calismali.
ensure_data() {
    [ -x /etc/init.d/S03mcosdata ] && /etc/init.d/S03mcosdata start
    return 0
}

# Restart any persisted Serveo tunnels (codes -> ssh commands). Per-server WAN
# tunnels normally auto-start with their server; this covers standalone codes.
start_tunnels() {
    local codes="$MCOS_DATA/tunnel-codes.json"
    [ -f "$codes" ] || return
    printf "Checking tunnels...\n"
    while IFS= read -r line; do
        code=$(echo "$line" | sed -n 's/.*"\([^"]*\)":".*/\1/p')
        if [ -n "$code" ]; then
            /usr/bin/mcosctl --connect "$SOCK" tunnel start "$code" >/dev/null 2>&1 || true
        fi
    done < "$codes"
}

start() {
    printf "Starting MCOS...\n"
    
    # Load Turkish keymap, enable UTF-8, and load a modern Terminus font for TUI
    # Konsol fontu: kbd pakedinin GERCEKTEN kurdugu fontlardan seciyoruz.
    # Eskiden "ter-u16n" deneniyordu; o font Terminus paketine ait ve imajda
    # yok, bu yuzden her acilista setfont hatasi basiliyordu (QEMU boot
    # testiyle yakalandi). Lat2-Terminus16 Turkce harfleri kapsar.
    printf '\033%%G'   # konsolu UTF-8 moduna al
    if command -v setfont >/dev/null 2>&1; then
        setfont Lat2-Terminus16 2>/dev/null \
            || setfont iso09.16 2>/dev/null \
            || setfont lat9u-16 2>/dev/null \
            || true
    fi
    if command -v loadkeys >/dev/null 2>&1; then
        loadkeys trq 2>/dev/null || true
    fi

    ensure_data
    mkdir -p /run/mcos

    # Start the daemon in the BACKGROUND only. The panel is launched separately
    # by init on the dedicated panel terminal (see /etc/inittab -> mcos-launch).
    # This script must NOT block on the panel: if it did, rcS would never finish,
    # init's console respawn entry would never run, and when the panel exited PID
    # 1 would panic ("Attempted to kill init"). Daemon applies wifi/timezone/
    # budget; the panel decides setup-vs-main from config.setupComplete.
    #
    # Send daemon output to a log file, NOT the console: the panel owns its own
    # full-screen TUI, and daemon log lines on the same tty would scribble over
    # the OOBE so it never appears. Logs live in /run/mcos/mcosd.log for debug.
    "$MCOSD" --data-root "$MCOS_DATA" --listen "$SOCK" >/run/mcos/mcosd.log 2>&1 &
    # "sleep 1" KALDIRILDI. Daemon soketi acsin diye konmustu, ama start_tunnels
    # zaten mcosctl ile konusuyor ve baglanamazsa sessizce vazgeciyor: bekleme
    # HICBIR SEYI garanti etmiyordu. Bedeli olculdu — her acilista tam bir
    # saniye, hem de panelin gorunmesinden tam once.
    start_tunnels
}

stop() {
    printf "Stopping MCOS...\n"
    killall mcos-panel 2>/dev/null
    killall ssh 2>/dev/null   # Serveo tunnels are ssh -R clients
    killall mcosd 2>/dev/null
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}" ;;
esac
