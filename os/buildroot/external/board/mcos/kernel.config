# Minimal x86_64 kernel config for MCOS
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
# Command line is passed dynamically by GRUB2 for live ISO and installed systems
# CONFIG_CMDLINE_BOOL is not set
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# --- Networking core (REQUIRED) ---
# Without CONFIG_NET, olddefconfig silently drops UNIX/INET/PACKET and the kernel
# has NO socket() syscall -> AF_UNIX returns ENOSYS ("socket: function not
# implemented"), so mcosd cannot listen. NETDEVICES gates the ethernet drivers.
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y
# ── Kablolu ag: eksik aileler ──────────────────────────────────────────────
# IGC  : Intel I225/I226 2.5G - 2020 sonrasi masaustu anakartlarin cogu.
# ALX / ATL1C / ATL1E / ATL1: Qualcomm-Atheros Killer/AR81xx dizustu ve
#        oyuncu anakartlari.
# TIGON3 (tg3): Broadcom NetXtreme - Dell/HP/Lenovo kurumsal masaustuler.
# BNX2 : Broadcom NetXtreme II; firmware'i (BR2_PACKAGE_LINUX_FIRMWARE_BNX2)
#        defconfig'te ZATEN vardi ama surucusu yoktu - bos yer kapliyordu.
# SKY2 : Marvell Yukon 2 - 2008-2013 dizustu ve anakartlar.
# AQTION: Aquantia/Marvell AQC107/113 5G/10G - ust segment anakartlar.
# FORCEDETH: nVidia nForce anakartlar.
CONFIG_IGC=y
CONFIG_ALX=y
CONFIG_ATL1=y
CONFIG_ATL1E=y
CONFIG_ATL1C=y
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_SKY2=y
CONFIG_AQTION=y
CONFIG_FORCEDETH=y
# USB ag bagdastiricilari: dahili ethernet'i olmayan ince dizustulerde tek
# kablolu yol. RTL8152/8153/8156 piyasadaki USB-ethernet'lerin cogunlugu;
# AX8817X eski ASIX'ler; RNDIS_HOST Android telefonla USB paylasimi.
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_VIRTIO_NET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SATA_AHCI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# ── TOUCHPAD: "bazi PClerde touchpad calismiyor" ───────────────────────────
#
# ── Duzeltilen gercek hata ─────────────────────────────────────────────────
#
# Kullanici "BAZI PCLERDE TOUCHPAD CALISMIYOR" dedi. Olculdu: bu cekirdekte
# touchpad'i surecek HICBIR SURUCU yoktu. CONFIG_INPUT_MOUSE=y yalnizca bir
# MENU basligi; altindaki surucularin hicbiri secilmemisti.
#
# Modern dizustulerin touchpad'i PS/2 uzerinde DEGIL, I2C-HID uzerindedir
# (2015 sonrasi Intel platformlarinin cogu). O yolun calismasi icin uc katman
# birden gerekir ve ucu de kapaliydi:
#
#   1. I2C denetleyicisi  : Intel Designware (i2c-designware-platform)
#   2. GPIO/pinctrl       : kesme hatti buradan gelir; PINCTRL ve GPIOLIB
#                           kapaliyken I2C-HID aygiti kesme ALAMAZ
#   3. HID katmani        : i2c-hid-acpi + hid-multitouch
#
# Biri bile eksikse touchpad /dev/input altinda AYGIT OLARAK HIC OLUSMAZ ve
# panel gorecek bir sey bulamaz. Kullanicinin "bazi PC'ler" dedigi ayrim tam
# olarak "PS/2 touchpad'li eski makineler" ile "I2C-HID'li yeni makineler"
# ayrimidir.
#
# NOT: kodda AYRI bir hata daha vardi ve o da duzeltildi - cozucu, hareketi
# yalnizca X ve Y AYNI pakette geldiginde hesapliyordu; cekirdek ise degismeyen
# ekseni hic gondermez, yani duz hareket HIC calismiyordu
# (bkz. internal/fbinput/touchpad_axis_test.go). Iki hata bagimsiz: biri
# aygitin hic gorunmemesi, oteki gorunen aygitin hareketinin yutulmasi.

# 1. GPIO + pinctrl: I2C-HID kesmesinin on kosulu.
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_AMD=y
# Eksik kalan Intel nesilleri. Her biri YALNIZCA kendi PCH/SoC'sinin GPIO
# denetleyicisini surer; biri eksikse o nesilde touchpad kesme alamaz ve
# i2c-hid "failed to get irq"/sessizlik ile dusmez, hic veri gelmez.
#   BROXTON  : Apollo Lake (ucuz dizustu/mini PC, Celeron N3350/J3455)
#   JASPERLAKE: Celeron/Pentium N4500/N5100 (2021+ ucuz dizustuler)
#   METEORLAKE: Core Ultra 1. nesil (2024 dizustuleri)
#   ELKHARTLAKE, LAKEFIELD: Atom x6000 / Core i5-L16G7
#   LYNXPOINT: Haswell (4. nesil) dizustu PCH'si
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_LAKEFIELD=y
CONFIG_PINCTRL_LYNXPOINT=y

# 2. I2C denetleyicisi (Intel Designware, ACPI uzerinden numaralandirilir).
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
# COMMON_CLK, I2C_DESIGNWARE_PLATFORM'in GIZLI on kosuludur:
#   depends on (ACPI && COMMON_CLK) || !ACPI      (drivers/i2c/busses/Kconfig:558)
# ACPI zaten acik, COMMON_CLK kapaliydi. Bu yuzden iki sembol de SESSIZCE yok
# sayiliyordu - gercek kconfig ikilisiyle olculdu:
#   istenen 262 sembolden 258'i cozuldu, I2C_DESIGNWARE_* ikisi de DUSTU.
# Bu tam olarak "yazdim ama hicbir sey degismedi" tuzagidir.
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_ACPI_I2C_OPREGION=y

# ── "touchpad hala yok gercek PC'lerde": ASIL EKSIK HALKA (LPSS) ───────────
#
# Yukaridaki designware surucusu I2C denetleyicisini ANCAK biri onu bir
# "platform aygiti" olarak yarattiktan sonra surer. Bu aygiti kimin yarattigi
# nesle gore degisir ve UCU DE KAPALIYDI (uretilmis .config'de olculdu:
# "# CONFIG_MFD_INTEL_LPSS_PCI is not set", X86_INTEL_LPSS ve
# X86_AMD_PLATFORM_DEVICE de kapali):
#
#   Intel Skylake (6. nesil) ve SONRASI: I2C denetleyicisi bir PCI aygitidir
#     (ornek 8086:9d60, a0e8, 51e8 - drivers/mfd/intel-lpss-pci.c:481/517/373).
#     Onu intel-lpss-pci bulur ve i2c_designware alt aygitini o yaratir.
#     MFD_INTEL_LPSS_PCI olmadan 2015 sonrasi HICBIR Intel dizustude I2C
#     touchpad gorunmez - kullanicinin gordugu tam olarak bu.
#   Intel Haswell/Broadwell/Bay Trail/Cherry Trail: denetleyici ACPI ile
#     gelir (INT33C2, INT3432, 80860F41, 808622C1). designware onu bulur
#     ama saatini ve guc yonetimini drivers/acpi/acpi_lpss.c verir; o dosya
#     tamamen "#ifdef CONFIG_X86_INTEL_LPSS" icinde (satir 30).
#   AMD Ryzen: denetleyici ACPI AMDI0010; saatini drivers/acpi/acpi_apd.c:233
#     verir, o da "#ifdef CONFIG_X86_AMD_PLATFORM_DEVICE" icinde. Saat
#     yoksa i2c_dw_clk_rate() 0 doner (i2c-designware-common.c:491) ve
#     zamanlama hesaplanamaz.
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
# PCI uzerinden gelen designware denetleyicileri (AMD Navi GPU'lardaki USB-C
# denetleyicisi, Merrifield vb.). LPSS'ten bagimsiz, ucuz.
CONFIG_I2C_DESIGNWARE_PCI=y
# Bay Trail/Cherry Trail'de I2C veri yolu PMIC ile PAYLASILIR; bu semafor
# olmadan veri yolu kilitlenebilir ve o yoldaki touchpad/dokunmatik ekran da
# gider. IOSF_MBI'yi X86_INTEL_LPSS secer (depends kosulu =y istiyor).
CONFIG_I2C_DESIGNWARE_BAYTRAIL=y

# 3. HID katmani: I2C-HID ve coklu dokunma.
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HIDRAW=y

# 4. PS/2 touchpad'ler (eski makineler) - bunlar da yoktu.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y

# ── SMBus + RMI4: BIRLIKTE ACILMALI ────────────────────────────────────────
#
# SMBus denetleyicileri (I2C_I801 Intel, I2C_PIIX4 AMD) KAPALIYDI. Bu yuzden
# psmouse'un "Synaptics/Elan'i SMBus'a devret" yolu hic calismiyordu ve
# touchpad'ler duz PS/2 kipinde kaliyordu (tek parmak, kotu ivme).
#
# DIKKAT - yalniz I2C_I801 acmak TEHLIKELIDIR: SMBus bulununca psmouse
# (synaptics.c, beyaz listedeki aygitlarda) touchpad'i RMI4 cekirdegine
# DEVREDER ve PS/2 tarafini birakir. RMI4'un su islevleri yoksa bugun calisan
# touchpad BOZULUR:
#   F03 (+F03_SERIO): trackpoint ve harici PS/2 aygitlarinin gecidi. Yoksa
#                     ThinkPad trackpoint'i ve onun fiziksel dugmeleri OLUR.
#   F3A / F30       : touchpad dugmeleri (GPIO/LED). Yoksa tiklama gitmez.
#   F11 / F12       : 2B konum raporu - hareketin kendisi.
# Bu yuzden hepsi AYNI blokta ve scripts/test-kernel-config.sh bu
# birlikteligi ayrica denetliyor.
CONFIG_I2C_SMBUS=y
CONFIG_I2C_I801=y
CONFIG_I2C_PIIX4=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_SMB=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F03=y
CONFIG_RMI4_F03_SERIO=y
CONFIG_RMI4_F3A=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
# I2C-HID uzerinden RMI kipinde gelen Synaptics touchpad'ler (PTP olmayan
# eski I2C modeller). hid-core bunlari yalnizca HID_RMI aciksa RMI grubuna
# atar; aksi halde hid-generic alir ve cok dokunma kaybolur.
CONFIG_HID_RMI=y
# INTEL_ISH_HID BILEREK YOK: Sensor Hub ivmeolcer/menteşe/ortam isigi
# sensorleri icindir, touchpad'ler ISH'ten GECMEZ (I2C-HID ya da PS/2/SMBus
# kullanir). Ayni sey AMD_SFH_HID icin gecerli.

# 5. Sanal makinelerde MUTLAK isaretci: imlec pencereye "yapismaz".
#    VMware ve VirtualBox ikisi de bu protokolu konusur.
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
# --- Console / virtual terminal (text console on real hardware) ---
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_UNIX98_PTYS=y
# --- Framebuffer: real-hardware video on BOTH UEFI (GOP) and BIOS (VESA) ---
# sysfb/simpledrm consume the framebuffer GRUB hands over (gfxpayload=keep),
# giving a working console + GUI on physical machines, not just QEMU virtio.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VBOXVIDEO=y
CONFIG_DRM_BOCHS=y

# ════════════════════════════════════════════════════════════════════════════
# GERCEK DONANIMDA KMS: TUM EKRAN KARTI SURUCULERI GOMULU, OTOMATIK ALGILAMA
# ════════════════════════════════════════════════════════════════════════════
#
# Kullanici: "tum ekran karti suruculerini gom imaja oto algilasin".
#
# ── Neden BIR KEZ GERI ALINMISTI, neden artik ACILABILIYOR ─────────────────
#
# Bu suruculer daha once eklenmis ve gercek PC'de acilis bozulmustu ("ekran
# gidiyo, sonra geliyo ama ilk karede kaliyo"). O gunku aciklama "panel
# simpledrm'in /dev/fb0'ini mmap'liyor, i915 devralinca esleme bosa cikiyor"
# idi. Olcum bunu KISMEN duzeltiyor (asagida): surucu gomuluyken simpledrm
# hic kaydolmuyor, yani panel dogrudan i915/amdgpu'nun fbdev EMULASYONUNU
# mmap'liyordu. Donmanin kesin mekanizmasi gercek donanim olmadan
# olculemedi; ortak nokta panelin fbdev mmap yoluydu.
#
# Artik panel ekran kartina DOGRUDAN (DRM/KMS dumb buffer) ciziyor ve AYGIT
# KOPMASINA DAYANIKLI (internal/drm/screen_linux.go): eski kart ENODEV verince
# kartlari yeniden tarar, yenisini acar, en iyi modu kurar. QEMU'da
# bochs-drm ve virtio-gpu ile dogrulandi. fbdev mmap yolu artik HIC
# kullanilmiyor; eski engel bu yuzden ortadan kalkti.
# Ustelik surucular GOMULU (=y) oldugu icin devralma kullanici alani
# baslamadan biter: drivers/Makefile gpu/'yu (satir 70) firmware/'den
# (satir 141, sysfb) ONCE baglar, yerli surucu aperture'u alirken
# sysfb_disable() cagirir ve simpledrm hic kaydedilmez. Panel dogrudan
# gercek karti acar. QEMU UEFI'de olculdu: -vga std ile YALNIZCA bochs-drm
# kaydoldu; yerli surucusu olmayan -device ramfb ile ise simpledrm kaydoldu.
#
# BUNUN BEDELI: devraldiktan SONRA dusen bir surucunun geri donusu YOKTUR -
# simpledrm'e dusmek mumkun degil. Asagidaki firmware karari bu yuzden
# pazarliksiz.
#
# ── ASIL RISK: KARA EKRAN (firmware) ───────────────────────────────────────
#
# Devralma ile firmware yuklemesinin SIRASI kaynaktan olculdu. Devralma
# firmware'den ONCE olur ve firmware yoksa probe basarisiz olursa: simpledrm
# artik hic gelmez, yeni surucu yok -> KARA EKRAN. Panelin dayanikliligi
# bunu kurtaramaz, cunku acacak hicbir kart kalmaz. Devralmadan ONCE dusen
# surucu ise zararsizdir: sysfb_disable() cagrilmadigi icin simpledrm sonra
# normal kaydolur.
#
#   radeon  radeon_drv.c:299 devralma probe'un ILK isi; microcode sonra
#           (r600.c/rv770.c/evergreen.c/ni.c/si.c/cik.c "Failed to load
#           firmware!" -> init hatasi -> probe hatasi). FIRMWARE ZORUNLU.
#           QEMU ati-vga (RV100) ile olculdu: firmware'siz "Direct firmware
#           load for radeon/R100_cp.bin failed with error -2"; firmware
#           initramfs'e eklenince "Loading R100 Microcode" basarili.
#   amdgpu  amdgpu_device.c:3664 devralma ip_early_init'ten SONRA. Vega ve
#           sonrasi (gfx9/10, sdma4, psp, smu, dmub) firmware'i early_init'te
#           ister ve amdgpu_ucode_request() hatayi bilerek -ENODEV'e cevirir
#           (amdgpu_ucode.c:1328; -ENOENT olsaydi IP blogu sessizce
#           atlanirdi) -> devralmadan ONCE duser, simpledrm kaydolur.
#           Bu, 6.6'nin tanidigi ama linux-firmware-20240115'te dosyasi
#           olmayan yeni yongalari da (psp_14_0_0, sdma_6_1_0) korur.
#           AMA SI/CIK/VI (gfx6/7/8: Tonga/Fiji/Polaris = RX 4xx/5xx) ve
#           gmc_v8 firmware'i sw_init'te, yani devralmadan SONRA ister ->
#           kara ekran. FIRMWARE ZORUNLU.
#   i915    i915_driver.c:489 devralma once; ama GuC/HuC yoksa i915_gem.c
#           -EIO'yu "GPU wedged, KMS canli" olarak ele aliyor, DMC yoksa
#           yalnizca guc tasarrufu kapaniyor. Ekran CALISIR. Firmware
#           GEREKMEZ (27 MB tasarruf).
#   nouveau nouveau_drm.c:790 once yalnizca ALGILAMA (subdev_mask=0) yapar,
#           taninmayan yonga devralmadan ONCE reddedilir. Firmware
#           gerektiren alt birimler (GR vb.) -ENODEV ile atlanir
#           (nvkm/engine/device/base.c NVKM_LAYOUT_ONCE); goruntu calisir,
#           yalnizca hizlandirma olmaz. Firmware GEREKMEZ (63 MB tasarruf).
#   digerleri (ast, mgag200, qxl, cirrus, gma500, hyperv, udl)
#           firmware istemez.
#
# Gomulu surucunun firmware'i initramfs'ten okuyabildigi de kaynaktan
# dogrulandi: drivers/base/firmware_loader/main.c:512 dosya sisteminden
# okumadan once wait_for_initramfs() cagiriyor (init/initramfs.c:730), yol
# listesinde /lib/firmware var. Initramfs acilmadan firmware aranmaz.
# Firmware paketleri mcos_defconfig'te (BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU,
# _RADEON); scripts/test-kernel-config.sh surucu acik + firmware kapali
# durumunu HATA sayar.
#
# ── Tek tek suruculer ──────────────────────────────────────────────────────
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
# SI (HD 7000) ve CIK (R7/R9 2xx) varsayilan olarak radeon'da kalir:
# radeon da gomulu oldugu icin amdgpu_drv.c:586/605 si_support/cik_support'u
# 0 yapar; bu iki satir yalnizca "amdgpu.si_support=1 radeon.si_support=0"
# ile amdgpu'ya gecme SECENEGINI acar. Iki surucu ayni karti ASLA birlikte
# almaz.
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
# DC olmadan Vega/Raven ve sonrasinda amdgpu'nun ekran motoru yok.
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_AST=y
CONFIG_DRM_MGAG200=y
CONFIG_DRM_QXL=y
CONFIG_DRM_GMA500=y
CONFIG_DRM_UDL=y
CONFIG_DRM_CIRRUS_QEMU=y
# vmwgfx ACIK — VMware ve VirtualBox (VMSVGA) icin.
#
# Kullanici MCOS'u VMware'de deniyor; kapali kalsaydi orada cozunurluk ve
# tazeleme yalnizca GRUB'un kurdugu tek modda kalirdi (simpledrm).
#
# Olculen kara ekran QEMU'nun -vga vmware OYKUNMESINE ozgu: vmwgfx probe'u
# devralmadan SONRA (vmwgfx_drv.c:1018) su denetimi yapiyor:
#     DISPLAY_TOPOLOGY yok && PITCHLOCK yok -> -ENOSYS "Hardware has no pitchlock"
# QEMU'nun hw/display/vmware_vga.c'si bu iki yetenegi hic bildirmiyor. Gercek
# VMware'in SVGA II aygiti ikisini de bildiriyor (Workstation 6.5'ten beri) ve
# VirtualBox'in VMSVGA'si Linux konuklarinda zaten vmwgfx ile calisiyor.
# Bilinen tek sinir: QEMU'da "-vga vmware" DESTEKLENMIYOR (kara ekran);
# QEMU'da -vga std / virtio kullanin (scripts/qemu.sh zaten oyle yapiyor).
CONFIG_DRM_VMWGFX=y
# Hyper-V sentetik ekrani HYPERV'e bagli (drivers/gpu/drm/Kconfig:393).
# Ekran tek basina ise yaramaz: Gen2 Hyper-V makinesinde disk (storvsc),
# ag (netvsc), klavye ve fare de sentetiktir; hepsi birlikte aciliyor.
CONFIG_HYPERV=y
# HYPERV_UTILS (kapatma/saat esitleme/kalp atisi) CONNECTOR'a bagli
# (drivers/hv/Kconfig:46). Ilk denemede CONNECTOR kapaliydi ve bu satir
# SESSIZCE DUSTU - scripts/test-kernel-config.sh yakaladi.
CONFIG_CONNECTOR=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_DRM_HYPERV=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
# --- UEFI boot (REQUIRED for real UEFI PCs) ---
# BIOS works via VESA/VGA, but UEFI hands the kernel a GOP framebuffer that only
# the EFI sysfb path can consume. Without CONFIG_EFI, efifb is dropped and the
# console freezes right after init starts ("MCOS starting" hang). EFI_STUB lets
# firmware load the bzImage directly; both BIOS and UEFI keep working.
CONFIG_PCI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_EARLYCON=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_SATA_AHCI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
# --- Wireless (WiFi) & RFKILL: broad laptop & USB WiFi support ---
CONFIG_RFKILL=y
CONFIG_RFKILL_LEDS=y
CONFIG_RFKILL_INPUT=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
# CONFIG_MAC80211_USB=y   <- KALDIRILDI: boyle bir Kconfig sembolu YOK
CONFIG_WLAN=y
CONFIG_FW_LOADER=y
CONFIG_NET_CORE=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y

# Intel Wireless
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y

# Atheros / Qualcomm Wireless (PCI + USB)
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH5K=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
# ── Yakalanan gercek hata: ATH11K YILLARDIR SESSIZCE DUSUYORDU ────────────
#
# Bu iki satir dosyada duruyordu ama HICBIR ISE YARAMIYORDU: kconfig onlari
# sessizce dusuruyordu, cunku bagimlilik karsilanmamisti
# (drivers/net/wireless/ath/ath11k/Kconfig:5):
#
#	depends on MAC80211 && HAS_DMA
#	depends on CRYPTO_MICHAEL_MIC      <- BU KAPALIYDI
#
# ATH11K, Qualcomm WCN685x / QCA639x ailesinin surucusudur; bircok modern
# dizustude Wi-Fi karti budur. Yani o makinelerde MCOS'un HIC Wi-Fi'si yoktu
# ve "wifiye baglaniyom internet yok" sikayetinin bir kismi bundan olabilir.
#
# Bu sinif hata artik scripts/test-kernel-config.sh ile yakalaniyor: yazilan
# her =y sembolunun GERCEKTEN cozuldugu dogrulaniyor.
CONFIG_CRYPTO_MICHAEL_MIC=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y

# Realtek Wireless (PCI + USB)
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RTLWIFI=y
CONFIG_RTLWIFI_PCI=y
CONFIG_RTL8192CE=y
CONFIG_RTL8192SE=y
CONFIG_RTL8192DE=y
CONFIG_RTL8723AE=y
CONFIG_RTL8723BE=y
CONFIG_RTL8188EE=y
CONFIG_RTL8821AE=y
CONFIG_RTL8192CU=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8723DE=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8821CU=y
# rtw88/rtw89 firmware dosyalari (rtw8822c, rtw8723d, rtw8852b, rtw8851b)
# imajda ZATEN vardi ama bu yongalarin surucusu acik degildi.
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8723DU=y
CONFIG_RTW89=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852CE=y
# RTL8852BE: 2022+ ucuz dizustulerde en yaygin Realtek Wi-Fi 6 karti.
CONFIG_RTW89_8852BE=y
CONFIG_RTW89_8851BE=y

# Broadcom Wireless
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_B43=y
CONFIG_B43LEGACY=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMSMAC=y

# Ralink / MediaTek Wireless (PCI + USB)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800PCI=y
CONFIG_RT2800USB=y
CONFIG_MT7601U=y
CONFIG_MT76x0U=y
CONFIG_MT76x0E=y
CONFIG_MT76x2E=y
CONFIG_MT76x2U=y
CONFIG_MT7615E=y
CONFIG_MT7921E=y
CONFIG_MT7921U=y
# CONFIG_MT7922=y   <- KALDIRILDI: boyle bir Kconfig sembolu YOK

# --- VirtualBox & Storage Drivers ---
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_MPIIX=y
CONFIG_PATA_SCH=y
CONFIG_ATA_GENERIC=y
CONFIG_SCSI_BUSLOGIC=y
# CONFIG_SCSI_LSILOGIC=y   <- KALDIRILDI: boyle bir Kconfig sembolu YOK (19.937 sembolde hic gecmiyor)
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_VBOXGUEST=y

# --- Early console & simple framebuffer for BIOS/UEFI VM compatibility ---
# CONFIG_FB_SIMPLE=y   <- KALDIRILDI: depends on !DRM_SIMPLEDRM - asla ayarlanamaz
CONFIG_EARLY_PRINTK=y

# ── Açılış sessizliği ───────────────────────────────────────────────────────
#
# X86_VERBOSE_BOOTUP AÇIKTI ve kapatıldı. Sebebi ölçüldü.
#
# "quiet loglevel=0" çekirdeğin printk mesajlarını susturur ama AÇMA
# (decompression) satırlarını susturmaz — onları çekirdekten önce çalışan
# açıcı basar ve printk seviyesine bakmaz:
#
#	early console in extract_kernel
#	Decompressing Linux... Parsing ELF... done.
#	Booting the kernel.
#
# QEMU'da ölçüldü: quiet ile bile bu satırlar ekranda kalıyordu. Kullanıcının
# isteği "acılırken linux logları felan gözükmesin" idi ve bu satırlar da tam
# olarak o. Kapatınca ekran, animasyon gelene kadar temiz kalıyor.
#
# EARLY_PRINTK AÇIK BIRAKILDI: o yalnızca "earlyprintk=" komut satırı
# verildiğinde çalışır ve bir açılış arızasını teşhis etmenin tek yoludur.
# Kurtarma girdisi (loglevel=7) zaten ayrı duruyor.
# CONFIG_X86_VERBOSE_BOOTUP is not set

# ── uinput: VNC'nin klavye/fare olayları ────────────────────────────────────
#
# RealVNC ile bağlanan kullanıcı paneli GERÇEKTEN kullanabilmeli. VNC sunucusu
# gelen tuş/fare olaylarını uinput ile SANAL BİR AYGIT olarak çekirdeğe
# veriyor; panel onları kendi evdev okuyucusuyla, yerel klavyeden gelenlerle
# aynı yoldan alıyor.
#
# Alternatif (paneli özel bir soketle beslemek) iki ayrı girdi yolu demekti:
# biri yerel, biri uzak. İki yol zamanla ayrışır ve "VNC'de çalışıyor ama
# klavyede çalışmıyor" türü hatalar üretir.
CONFIG_INPUT_UINPUT=y

# ── Kaynak denetimi (cgroup v2) ─────────────────────────────────────────────
#
# NEDEN EKLENDI: "Turbo" ve "sunucu basina CPU payi" ayarlari vardi ama
# CEKIRDEKTE HICBIR CGROUP DESTEGI YOKTU - yani CPU siniri tamamen goruntuden
# ibaretti. MaxServerCPUPercent yalnizca yapilandirmada duruyor, hicbir yerde
# uygulanmiyordu (olculdu: repo genelinde tek bir cgroup cagrisi yok).
#
# cgroup v2 secildi (v1 degil): tek birlesik hiyerarsi, daha basit API ve
# BusyBox ile sorunsuz calisiyor.
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# CFS_BANDWIDTH olmadan cpu.max yazilamaz - CPU siniri islevinin tam kalbi.
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y

# ════════════════════════════════════════════════════════════════════════════
# VirtualBox / sanal makine uyumlulugu
# ════════════════════════════════════════════════════════════════════════════
#
# Asagidaki her satir, gercek bir eksigi kapatir. Hepsi kaynak agacindaki
# Kconfig sembolleriyle dogrulandi.

# ── Hypervisor konuk destegi ────────────────────────────────────────────────
#
# NEDEN KRITIK: HYPERVISOR_GUEST kapaliyken hypervisor_is_type() her zaman
# "native" doner. vmwgfx surucusu bu yuzden her hypervisorde -hatta gercek
# VMware'de bile- "desteklenmiyor" karari verir. Ama bunu yapmadan ONCE
# firmware framebuffer'ini devre disi birakir; sonuc: /dev/fb0 kaybolur ve
# panel hic acilmaz.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

# ── VirtualBox konuk surucusu ───────────────────────────────────────────────
#
# CONFIG_VBOXGUEST tek basina YETMEZ: "if VIRT_DRIVERS" blogunun icindedir ve
# o kapaliydi. Yani VBOXGUEST satiri uretilen .config'e hic ulasmiyordu.
CONFIG_VIRT_DRIVERS=y
CONFIG_VBOXGUEST=y

# ── Depolama denetleyicileri ────────────────────────────────────────────────
#
# VirtualBox'ta secilebilen ama surucusu OLMAYAN denetleyiciler. Kullanici
# LsiLogic veya virtio-scsi secerse disk hic gorunmuyordu.
CONFIG_SCSI_SYM53C8XX_2=y
CONFIG_SCSI_SYM53C8XX_DMA_ADDRESSING_MODE=1
CONFIG_SCSI_SYM53C8XX_DEFAULT_TAGS=16
CONFIG_SCSI_SYM53C8XX_MAX_TAGS=64
CONFIG_SCSI_SYM53C8XX_MMIO=y
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_FUSION_SAS=y
CONFIG_FUSION_MAX_SGE=128
CONFIG_SCSI_VIRTIO=y

# ── PCI kesmeleri ───────────────────────────────────────────────────────────
#
# PCI_MSI'nin "default y" degeri yok ve listede hic yoktu: her aygit eski
# INTx kesmesine dusuyordu. Acilisi engellemez ama NVMe/AHCI/xHCI/virtio
# performansini dusurur.
CONFIG_PCI_MSI=y

# ── Gercek zaman saati ──────────────────────────────────────────────────────
#
# RTC_CLASS "default n" ve listede yoktu: /dev/rtc0 hic olusmuyor, duvar
# saati her acilista 1970'te basliyordu. Bu, TLS sertifika dogrulamasini
# bozar (indirmeler basarisiz olur) ve tum gunluk zaman damgalarini
# anlamsiz yapar.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_CMOS=y

# ── Framebuffer aygit dugumu ────────────────────────────────────────────────
#
# FB_DEVICE 6.6'da yeni ve "default FB" oldugu icin su an SANS ESERI aciliyor.
# mcos-launch /dev/fb0 yoksa paneli hic baslatmiyor, bu yuzden sansa
# birakilmamali.
CONFIG_FB_DEVICE=y

# ── vmwgfx ─────────────────────────────────────────────────────────────────
# Acik; gerekce ve bilinen tek sinir (QEMU -vga vmware) GPU bolumunde.

# ── Ses ─────────────────────────────────────────────────────────────────────
#
# NEDEN: kullanıcı geçiş animasyonlarında hoparlörden efekt istedi
# ("bide hoparlörden efekt calsın gecis animasyonlarinda ama kapatılabilsin").
# Bu çekirdekte ses DESTEĞİ HİÇ YOKTU: CONFIG_SOUND bile ayarlı değildi, yani
# /dev/snd altında hiçbir aygıt oluşmuyordu ve hangi kullanıcı alanı aracı
# denenirse denensin sessizlikle sonuçlanırdı.
#
# Seçim gerekçeleri:
#   SND_HDA_INTEL    : 2005'ten beri hemen her dizüstü/masaüstü. VirtualBox'ın
#                      "Intel HD Audio" denetleyicisi ve QEMU'nun intel-hda'sı
#                      da budur — yani sanal makinede de duyulur.
#   SND_HDA_GENERIC  : kodek tanınmazsa genel sürücü devreye girer; "ses kartı
#                      var ama çıkış yok" durumunu büyük ölçüde kapatır.
#   REALTEK / HDMI   : tüketici donanımında en yaygın iki kodek ailesi.
#   SND_INTEL8X0     : AC'97. VirtualBox'ın eski varsayılanı ve QEMU'nun
#                      -device AC97'si.
#   SND_USB_AUDIO    : USB kulaklık/hoparlör — bir sunucu kutusunda dahili ses
#                      çıkışı hiç olmayabilir.
#   INPUT_PCSPKR     : son çare. Anakart bipçisi EV_SND ile çalınır; ALSA
#                      aygıtı hiç yoksa panel buraya düşer.
#
# SOF (Sound Open Firmware) BİLEREK KAPALI: yeni Intel dizüstülerinde daha iyi
# çalışır ama ÇALIŞMA ANINDA FIRMWARE BLOB'U ister. O blob'lar imajda yok ve
# eklemek initramfs'i (tamamen RAM'e açılıyor) onlarca MB büyütürdü. Eski
# HDA yolu firmware'siz çalışır.
#
# SND_PCSP da bilerek KAPALI: o, bipçiyi bir ALSA aygıtı gibi gösterir ve
# INPUT_PCSPKR ile AYNI donanımı sürmeye çalışır; ikisi birlikte açıkken
# hangisinin bipçiyi aldığı sıraya bağlıdır.
# ── Düzeltilen gerçek hata: ALSA'nın dmix'i System V IPC istiyor ────────────
#
# Ses eklendikten sonra QEMU'da uçtan uca ölçüldü ve HİÇBİR ses çıkmadı.
# mcos-soundcheck ile sebebi bulundu:
#
#   ALSA lib pcm_direct.c:2188:(_snd_pcm_direct_new)
#       unable to create IPC semaphore
#   aplay: main:850: audio open error: Function not implemented
#
# "default" PCM aygıtı alsa-lib'de dmix'tir (yazılım karıştırıcı) ve süreçler
# arası kilit için semget() kullanır. Çekirdekte CONFIG_SYSVIPC kapalı olduğu
# için o çağrı ENOSYS döner — yani ses kartı, sürücü, aplay ve alsa.conf'un
# HEPSİ doğru olmasına rağmen tek bir örnek bile çalınamaz.
#
# İki ayrı savunma kuruldu: (1) burada SYSVIPC açılıyor, (2) panelin ses
# arka ucu "default" başarısız olursa plughw:0,0'a düşüyor (dmix'i tamamen
# atlar; bkz. internal/sound/backend_linux.go).
CONFIG_SYSVIPC=y

CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_ANALOG=y
# Kalan TUM HDA kodek aileleri. Kodek surucusu yoksa SND_HDA_GENERIC devreye
# girer, ama genel surucu pin yapilandirmasi tuhaf olan kodeklerde (Conexant
# dizustuler, Cirrus'lu MacBook'lar, CA0132'li Creative/Alienware) hoparloru
# hic acmaz: "ses karti var, ses yok". Her biri birkac on KB.
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CS8409=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_CA0110=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_CODEC_SI3054=y
# SOF HALA KAPALI (asagidaki SND_SOC satiri). Degerlendirme: SOF, DSP'li
# Intel dizustulerde (Tiger Lake+ dijital mikrofon, SoundWire kodekli yeni
# Dell/Lenovo) gerekir ve CALISMA ANINDA sof-bin firmware'i ister. Buildroot
# 2024.02'nin linux-firmware paketinde SOF secenegi YOK. SOF gomulup firmware
# olmazsa sound/hda/intel-dsp-config.c o makineleri SOF'a yonlendirir, SOF
# probe'u duser ve bugun eski HDA yoluyla calisan hoparlor de SUSAR. Yani
# firmware'siz SOF, olmayan SOF'tan KOTUDUR. SOF kapaliyken ayni makineler
# snd-hda-intel ile hoparlor/kulaklik verir; eksik kalan yalnizca DMIC ve
# SoundWire-yalniz tasarimlar.
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_INTEL8X0=y
# ── Ensoniq AudioPCI: sanal makinelerin klasik ses karti ───────────────────
#
# ── Duzeltilen gercek hata ─────────────────────────────────────────────────
#
# Kullanici: "SES EFEKTI CALMIYOR BIP SESI CALIYOR".
#
# OLCULEN: bu cekirdekte sound/pci altinda TEK bir ses surucusu derleniyordu
# (intel8x0.o). Ensoniq ailesi tamamen kapaliydi:
#   .config:3124-3125 -> "# CONFIG_SND_ENS1370 is not set"
#                        "# CONFIG_SND_ENS1371 is not set"
# intel8x0'in kimlik tablosunda (sound/pci/intel8x0.c) yalnizca
# Intel/SiS/NVIDIA/AMD/ALi var; Ensoniq YOK. Yani Ensoniq kartli bir sanal
# makinede /dev/snd HIC olusmuyor ve panel anakart bipcisine dusuyor.
#
# QEMU'da ES1370 karti takilip DENENDI: konuk "--- no soundcards ---" dedi,
# duzeltmeden sonra ses aygiti olustu.
#
# ── ES1370 ile ES1371 AYRI SURUCULERDIR ────────────────────────────────────
#
# Once yalnizca ENS1371 acildi ve QEMU testi HALA ses karti bulamadi.
# sound/pci/ens1370.c:427 bunu acikliyor - ayni KAYNAK dosya, iki AYRI
# yapilandirma sembolu ve iki ayri PCI kimlik listesi:
#
#	#ifdef CHIP1370                          <- CONFIG_SND_ENS1370
#	{ PCI_VDEVICE(ENSONIQ, 0x5000) }         /* ES1370 */
#	#endif
#	#ifdef CHIP1371                          <- CONFIG_SND_ENS1371
#	{ PCI_VDEVICE(ENSONIQ, 0x1371) }         /* ES1371 */
#	{ PCI_VDEVICE(ENSONIQ, 0x5880) }         /* ES1373 - CT5880 */
#	{ PCI_VDEVICE(ECTIVA,  0x8938) }         /* Ectiva EV1938 */
#	#endif
#
# Hangi sanal makinenin hangisini verdigini TAHMIN ETMEK yerine ikisi de
# aciliyor. Maliyet birkac KB.
#
# ── DURUST OLMAK GEREKEN YER ───────────────────────────────────────────────
#
# "VMware her zaman ES1371 verir" denemez: OLCULMEDI. VMware sanal ses aygiti
# modelini KONUK ISLETIM SISTEMI TURUNE gore seciyor; yeni konuk turlerinde
# "hdaudio" yaziyor. Bir makinede hangisinin verildigi ancak orada goruluir:
#
#	lspci -nn | grep -i audio        (ya da)  dmesg | grep -i snd
#
# VMware HD Audio (15ad:1977) ZATEN destekleniyordu ve bir SINIF kuralindan
# degil, hda_intel.c:2738'deki ACIK kimlik girdisinden:
#	{ PCI_VDEVICE(VMWARE, 0x1977), .driver_data = AZX_DRIVER_GENERIC }
# (Tabloda saticidan bagimsiz sinif girdisi HIC yoktur; onceki yorumda
#  "hda_intel yalnizca sinif 0x0403 alir" yaziyordu, bu YANLISTI.)
#
# Yani bu ekleme HD Audio'yu degil, Ensoniq'li kurulumlari kurtariyor.
CONFIG_SND_ENS1370=y
CONFIG_SND_ENS1371=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
# /proc/asound/{cards,pcm}: panel efekt ve ses seviyesi icin HANGI kartin
# hoparlor oldugunu buradan seciyor (internal/sound/cards.go: HDMI yerine
# analog/USB). Kconfig varsayilani zaten "y"; acikca yaziliyor ki biri
# cekirdegi kucultmek icin kapatirsa sesin neden HDMI'ye gittigi anlasilsin.
CONFIG_SND_PROC_FS=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PCSPKR=y
# CONFIG_SND_PCSP is not set
# CONFIG_SND_SOC is not set

# ════════════════════════════════════════════════════════════════════════════
# Gercek PC depolama ve USB
# ════════════════════════════════════════════════════════════════════════════
#
# VMD: Intel 11. nesil ve sonrasi dizustulerin cogu fabrikadan "Intel RST /
# VMD" kipinde gelir. O kipte NVMe diskler PCI'da DOGRUDAN GORUNMEZ; VMD
# denetleyicisinin arkasinda saklanir (drivers/pci/controller/vmd.c). VMD
# surucusu yoksa lsblk bos doner ve mcos-install "disk yok" der - kullanici
# BIOS'ta AHCI'ye gecmeyi bilmiyorsa kurulum imkansiz.
CONFIG_VMD=y
# SD/eMMC: ucuz dizustu ve mini PC'lerin (Celeron N, Atom) TEK diski eMMC'dir.
# SDHCI_ACPI Bay Trail/Cherry Trail/AMD eMMC'si, SDHCI_PCI digerleri icin.
# MISC_RTSX_* + MMC_REALTEK_*: dizustulerdeki Realtek kart okuyucular.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MISC_RTSX_PCI=y
CONFIG_MISC_RTSX_USB=y
CONFIG_MMC_REALTEK_PCI=y
CONFIG_MMC_REALTEK_USB=y
# USB4/Thunderbolt: Ice Lake ve sonrasinda Thunderbolt baglanti yonetimi
# yazilimda (software connection manager). Surucu yoksa Thunderbolt dock'un
# arkasindaki ethernet/ekran/USB hic acilmaz.
CONFIG_USB4=y

# ── 32 bit program desteği (Ventoy normal kipi için ŞART) ─────────────────────
#
# Yakalanan gerçek hata: kullanıcı "Ventoy'da normal modda açınca kernel panic"
# dedi. Ventoy 1.1.17 ile QEMU'da yeniden üretildi ve seri konsoldan okundu:
#
#   Run /init as init process
#   Failed to execute /init (error -8)
#   Kernel panic - not syncing: No working init found.
#
# Ventoy normal kipte initrd'ye kendi kancasını enjekte eder; kancanın /init'i
# "#!/ventoy/busybox/ash" ile başlar ve o ash 32 bitlik (i386) statik bir ELF'tir.
# Bu çekirdekte IA32_EMULATION kapalıydı: çekirdek 32 bit programı çalıştıramadı
# (-ENOEXEC = -8) ve init bulunamadı. grub2 kipinde kanca farklı bir yoldan
# (rdinit=/vtoy/vtoy, ISO'nun kendi 64 bit kabuğuyla) çalıştığı için orada
# sorun yoktu — belirtinin yalnızca normal kipte görülmesinin sebebi bu.
CONFIG_IA32_EMULATION=y

# ── Ventoy bölümü: exFAT ve NTFS (dosya tabanlı kalıcılık için ŞART) ──────────
#
# Ventoy'dan açılan MCOS'ta kalıcılık Ventoy'un veri bölümündeki
# /mcos/mcos-data.dat dosyasıdır (rootfs-overlay/usr/bin/mcos-vtoydata).
# Ventoy2Disk o bölümü VARSAYILAN olarak exFAT biçimler (NTFS seçilebilir).
# Bu çekirdekte ikisi de kapalıydı: bölüm hiç bağlanamaz, kalıcılık dosyası ne
# oluşturulabilir ne okunabilirdi. (VFAT zaten açık: FAT32 Ventoy'u da çalışır.)
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y

# ── Turbo: frekans sürücüsü, güç sınırı (RAPL), sıcaklık ve fan sürücüleri ────
#
# Yakalanan gerçek hata: kullanıcı gerçek PC'de "turboda 4,4 GHz olması
# lazımken 2,4 GHz oluyor, fan da çalışmıyor, PC ısınmıyor" dedi. Derlenmiş
# çekirdeğin .config'i okundu; turbonun ihtiyaç duyduğu her şey KAPALIYDI:
#
#   # CONFIG_POWERCAP is not set         -> PL1/PL2 ne okunur ne değişir
#   # CONFIG_X86_AMD_PSTATE is not set   -> AMD'de hiç cpufreq sürücüsü yok
#   # CONFIG_X86_ACPI_CPUFREQ is not set    (frekans BIOS'un bıraktığı yerde)
#   # CONFIG_INTEL_IDLE is not set       -> yalnızca ACPI _CST C-durumları
#   # CONFIG_SENSORS_CORETEMP is not set -> işlemci sıcaklığı görünmüyor
#   # CONFIG_THINKPAD_ACPI / SENSORS_DELL_SMM / HP_WMI / ASUS_WMI /
#   #   IDEAPAD_LAPTOP / SENSORS_NCT6775 / SENSORS_IT87 is not set
#                                        -> dizüstüde EC fanına, masaüstünde
#                                           Super I/O fanına HİÇ yol yok
#
# Bu dosya Buildroot'ta .config olarak alınıp olddefconfig'ten geçiyor; adı
# geçmeyen seçenek Kconfig öntanımlısını alır ve bunların öntanımlısı yok.
# (MODULES=n'de "default m" y'ye yükselir — symbol.c sym_calc_value — ama
# HP_WMI'nin "default m"i bile X86_PLATFORM_DRIVERS_HP menüsü kapalı olduğu
# için hiç görünmüyordu.)
#
# Frekans sürücüleri. Başlatma sırası: intel_pstate ve amd-pstate
# device_initcall, acpi-cpufreq late_initcall; önce yüklenen kazanır, ikincisi
# EEXIST ile çekilir. acpi-cpufreq: CPPC'siz AMD (Zen1/Zen+) ve intel_pstate'in
# tanımadığı Intel için yedek. X86_ACPI_CPUFREQ_CPB: AMD çekirdek artırması.
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_X86_ACPI_CPUFREQ_CPB=y
# intel_idle: yerel C6/C8/C10. Turbo tavanı ETKİN çekirdek sayısına bağlı;
# boştaki çekirdek derin uykuya inmezse yükteki çekirdek tek çekirdek turbo
# oranına (4,4 GHz) çıkamaz (bkz. internal/turbo/turbo.go, cstateItem).
CONFIG_INTEL_IDLE=y
# RAPL: /sys/class/powercap/intel-rapl:* (MSR) ve intel-rapl-mmio:* (INT340X
# işlemci ısıl aygıtı). Dizüstüde BIOS'un PL1'i 15-28 W: tüm çekirdekler bu
# güce sığan ~2,4 GHz'e iner, güç düşük kaldığı için makine ısınmaz ve EC
# fanı hızlanmaz. MMIO bölgesi AYRI bir PL1 taşır, etkin sınır ikisinin
# küçüğü; ikisi de gerekli. INT340X'in ısıl bölgeleri user_space yöneticisiyle
# kaydolur (int340x_thermal_zone.c): çekirdek kendisi hiçbir şeyi kısmaz.
# AMD'de intel_rapl yalnızca enerji sayacı verir (tüketim tanısı için).
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y
CONFIG_INT340X_THERMAL=y
CONFIG_PROC_THERMAL_MMIO_RAPL=y
# /dev/cpu/N/msr: turbo tanısı YALNIZCA OKUR (APERF/MPERF ile ölçülen gerçek
# frekans, 0x64F frekans kısma nedenleri, PL kilit biti, TjMax/TCC ofseti).
# "Neden 2,4 GHz" sorusunun kesin cevabı buradan gelir.
CONFIG_X86_MSR=y
# Sıcaklık: Intel paket/çekirdek, AMD Tctl.
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
# Dizüstü fanları EC'dedir; Linux'tan ancak üretici sürücüsüyle sürülür.
# Hepsi DMI/ACPI kimliğiyle yalnızca kendi makinesinde bağlanır.
#   thinkpad_acpi: /proc/acpi/ibm/fan — elle kademe için komut satırında
#                  thinkpad_acpi.fan_control=1 (scripts/lib/display.sh)
#   dell-smm:      hwmon pwmN (+ beyaz listede pwm1_enable)
#   hp-wmi:        hwmon pwm1_enable (0 = tam hız, 2 = otomatik)
#   asus-wmi:      pwm1_enable, fan_boost_mode, throttle_thermal_policy
#   ideapad:       fan_mode (4 = en güçlü soğutma) ve platform profili (DYTC)
# msi-ec EKLENMEDİ: 6.6'da yalnızca pil eşiği sunuyor, fan (cooler_boost)
# sysfs'i yok. Legion'a özel sürücü (legion-laptop) ana çekirdekte yok.
CONFIG_THINKPAD_ACPI=y
CONFIG_SENSORS_DELL_SMM=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=y
CONFIG_ASUS_WMI=y
CONFIG_ASUS_NB_WMI=y
CONFIG_IDEAPAD_LAPTOP=y
# Masaüstü Super I/O (Nuvoton, ITE): pwmN/pwmN_enable. Çoğu kartta fan yongası
# ACPI OpRegion'la çakışır ve sürücü "resource conflict" ile yüklenmez; ASUS
# kartlarında nct6775 WMI üzerinden bağlanır. acpi_enforce_resources=lax
# BİLEREK komut satırında YOK: çekirdeğin TÜM ACPI kaynak korumasını kaldırır
# (i801 SMBus dahil) ve BIOS'la aynı yongaya eşzamanlı erişime izin verir.
# Masaüstü fanı zaten BIOS'un eğrisinde döner; çakışma olursa turbo tanısı
# bunu çekirdek günlüğünden gösterir.
CONFIG_SENSORS_NCT6775=y
CONFIG_SENSORS_IT87=y

# ── Minecraft sunucu performansı (çekirdek) ───────────────────────────────────
#
# Kullanıcı (gerçek PC, SD karta kurulu): "performans baya felaket kötü",
# "the server has not responded for 10 seconds sürekli oluyor". Derlenmiş
# .config'te ölçülenler ve karşılıkları:
#
#   CONFIG_HZ_PERIODIC=y  -> boştaki HER çekirdek saniyede 250 kez uyanıyordu;
#                            derin C-durumuna inemeyen çekirdekler paket güç
#                            bütçesini yiyor, yüklü çekirdeğin turbo payı
#                            azalıyordu. NO_HZ_IDLE: boştaki çekirdek uyur.
#   PREEMPT_NONE          -> çekirdek içinde uzun süren bir iş (ör. yavaş SD
#                            karta yazma geri dönüşü) sunucunun ana iş
#                            parçacığını bekletebiliyordu. VOLUNTARY, iş
#                            hacminden neredeyse hiç ödün vermeden gecikmeyi
#                            düşürür (sunucu dağıtımlarının varsayılanı).
#   THP yok               -> büyük Java yığını 4 KB sayfalarla: TLB ıskaları.
#                            madvise kipi: yalnızca isteyen (JVM,
#                            -XX:+UseTransparentHugePages) kullanır.
#   G/Ç zamanlayıcısı yok -> SD kartta toplu yazma sürerken okumalar (bölge
#                            dosyası, eklenti) sıraya giriyordu. mq-deadline
#                            okumaya son tarih verir; WBT yazma geri
#                            dönüşünün okuma gecikmesini boğmasını engeller.
#   zram yok              -> kök dosya sistemi RAM'de (tmpfs); soğuk sayfaları
#                            sıkıştırılamıyordu. zram takası (lz4: hızlı)
#                            o belleği sunuculara geri verir.
CONFIG_NO_HZ_IDLE=y
# CONFIG_HZ_PERIODIC is not set
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_PREEMPT_NONE is not set
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
