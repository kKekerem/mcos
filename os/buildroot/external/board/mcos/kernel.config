# Minimal x86_64 kernel config for MCOS
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
# Command line is passed dynamically by GRUB2 for live ISO and installed systems
# CONFIG_CMDLINE_BOOL is not set
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# --- Networking core (REQUIRED) ---
# Without CONFIG_NET, olddefconfig silently drops UNIX/INET/PACKET and the kernel
# has NO socket() syscall -> AF_UNIX returns ENOSYS ("socket: function not
# implemented"), so mcosd cannot listen. NETDEVICES gates the ethernet drivers.
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y
CONFIG_VIRTIO_NET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SATA_AHCI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
# --- Console / virtual terminal (text console on real hardware) ---
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_UNIX98_PTYS=y
# --- Framebuffer: real-hardware video on BOTH UEFI (GOP) and BIOS (VESA) ---
# sysfb/simpledrm consume the framebuffer GRUB hands over (gfxpayload=keep),
# giving a working console + GUI on physical machines, not just QEMU virtio.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VBOXVIDEO=y
# CONFIG_DRM_VMWGFX=y   <- KAPATILDI: VirtualBox VMSVGA ile firmware fb yok olur
#                          (probe once fb devre disi birakir, uyumluluk kontrolu
#                           SONRA gelir ve VBox'ta her zaman basarisiz olur)
CONFIG_DRM_BOCHS=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
# --- UEFI boot (REQUIRED for real UEFI PCs) ---
# BIOS works via VESA/VGA, but UEFI hands the kernel a GOP framebuffer that only
# the EFI sysfb path can consume. Without CONFIG_EFI, efifb is dropped and the
# console freezes right after init starts ("MCOS starting" hang). EFI_STUB lets
# firmware load the bzImage directly; both BIOS and UEFI keep working.
CONFIG_PCI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_EARLYCON=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_SATA_AHCI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
# --- Wireless (WiFi) & RFKILL: broad laptop & USB WiFi support ---
CONFIG_RFKILL=y
CONFIG_RFKILL_LEDS=y
CONFIG_RFKILL_INPUT=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
# CONFIG_MAC80211_USB=y   <- KALDIRILDI: boyle bir Kconfig sembolu YOK
CONFIG_WLAN=y
CONFIG_FW_LOADER=y
CONFIG_NET_CORE=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y

# Intel Wireless
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y

# Atheros / Qualcomm Wireless (PCI + USB)
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH5K=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y

# Realtek Wireless (PCI + USB)
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RTLWIFI=y
CONFIG_RTLWIFI_PCI=y
CONFIG_RTL8192CE=y
CONFIG_RTL8192SE=y
CONFIG_RTL8192DE=y
CONFIG_RTL8723AE=y
CONFIG_RTL8723BE=y
CONFIG_RTL8188EE=y
CONFIG_RTL8821AE=y
CONFIG_RTL8192CU=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8723DE=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8821CU=y
CONFIG_RTW89=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852CE=y

# Broadcom Wireless
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_B43=y
CONFIG_B43LEGACY=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMSMAC=y

# Ralink / MediaTek Wireless (PCI + USB)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800PCI=y
CONFIG_RT2800USB=y
CONFIG_MT7601U=y
CONFIG_MT76x0U=y
CONFIG_MT76x0E=y
CONFIG_MT76x2E=y
CONFIG_MT76x2U=y
CONFIG_MT7615E=y
CONFIG_MT7921E=y
CONFIG_MT7921U=y
# CONFIG_MT7922=y   <- KALDIRILDI: boyle bir Kconfig sembolu YOK

# --- VirtualBox & Storage Drivers ---
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_MPIIX=y
CONFIG_PATA_SCH=y
CONFIG_ATA_GENERIC=y
CONFIG_SCSI_BUSLOGIC=y
# CONFIG_SCSI_LSILOGIC=y   <- KALDIRILDI: boyle bir Kconfig sembolu YOK (19.937 sembolde hic gecmiyor)
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_VBOXGUEST=y

# --- Early console & simple framebuffer for BIOS/UEFI VM compatibility ---
# CONFIG_FB_SIMPLE=y   <- KALDIRILDI: depends on !DRM_SIMPLEDRM - asla ayarlanamaz
CONFIG_EARLY_PRINTK=y
CONFIG_X86_VERBOSE_BOOTUP=y

# ── Kaynak denetimi (cgroup v2) ─────────────────────────────────────────────
#
# NEDEN EKLENDI: "Turbo" ve "sunucu basina CPU payi" ayarlari vardi ama
# CEKIRDEKTE HICBIR CGROUP DESTEGI YOKTU - yani CPU siniri tamamen goruntuden
# ibaretti. MaxServerCPUPercent yalnizca yapilandirmada duruyor, hicbir yerde
# uygulanmiyordu (olculdu: repo genelinde tek bir cgroup cagrisi yok).
#
# cgroup v2 secildi (v1 degil): tek birlesik hiyerarsi, daha basit API ve
# BusyBox ile sorunsuz calisiyor.
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# CFS_BANDWIDTH olmadan cpu.max yazilamaz - CPU siniri islevinin tam kalbi.
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y

# ════════════════════════════════════════════════════════════════════════════
# VirtualBox / sanal makine uyumlulugu
# ════════════════════════════════════════════════════════════════════════════
#
# Asagidaki her satir, gercek bir eksigi kapatir. Hepsi kaynak agacindaki
# Kconfig sembolleriyle dogrulandi.

# ── Hypervisor konuk destegi ────────────────────────────────────────────────
#
# NEDEN KRITIK: HYPERVISOR_GUEST kapaliyken hypervisor_is_type() her zaman
# "native" doner. vmwgfx surucusu bu yuzden her hypervisorde -hatta gercek
# VMware'de bile- "desteklenmiyor" karari verir. Ama bunu yapmadan ONCE
# firmware framebuffer'ini devre disi birakir; sonuc: /dev/fb0 kaybolur ve
# panel hic acilmaz.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

# ── VirtualBox konuk surucusu ───────────────────────────────────────────────
#
# CONFIG_VBOXGUEST tek basina YETMEZ: "if VIRT_DRIVERS" blogunun icindedir ve
# o kapaliydi. Yani VBOXGUEST satiri uretilen .config'e hic ulasmiyordu.
CONFIG_VIRT_DRIVERS=y
CONFIG_VBOXGUEST=y

# ── Depolama denetleyicileri ────────────────────────────────────────────────
#
# VirtualBox'ta secilebilen ama surucusu OLMAYAN denetleyiciler. Kullanici
# LsiLogic veya virtio-scsi secerse disk hic gorunmuyordu.
CONFIG_SCSI_SYM53C8XX_2=y
CONFIG_SCSI_SYM53C8XX_DMA_ADDRESSING_MODE=1
CONFIG_SCSI_SYM53C8XX_DEFAULT_TAGS=16
CONFIG_SCSI_SYM53C8XX_MAX_TAGS=64
CONFIG_SCSI_SYM53C8XX_MMIO=y
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_FUSION_SAS=y
CONFIG_FUSION_MAX_SGE=128
CONFIG_SCSI_VIRTIO=y

# ── PCI kesmeleri ───────────────────────────────────────────────────────────
#
# PCI_MSI'nin "default y" degeri yok ve listede hic yoktu: her aygit eski
# INTx kesmesine dusuyordu. Acilisi engellemez ama NVMe/AHCI/xHCI/virtio
# performansini dusurur.
CONFIG_PCI_MSI=y

# ── Gercek zaman saati ──────────────────────────────────────────────────────
#
# RTC_CLASS "default n" ve listede yoktu: /dev/rtc0 hic olusmuyor, duvar
# saati her acilista 1970'te basliyordu. Bu, TLS sertifika dogrulamasini
# bozar (indirmeler basarisiz olur) ve tum gunluk zaman damgalarini
# anlamsiz yapar.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_CMOS=y

# ── Framebuffer aygit dugumu ────────────────────────────────────────────────
#
# FB_DEVICE 6.6'da yeni ve "default FB" oldugu icin su an SANS ESERI aciliyor.
# mcos-launch /dev/fb0 yoksa paneli hic baslatmiyor, bu yuzden sansa
# birakilmamali.
CONFIG_FB_DEVICE=y

# ── vmwgfx KAPALI ───────────────────────────────────────────────────────────
#
# VirtualBox'in varsayilan ekran denetleyicisi VMSVGA'dir ve vmwgfx onun PCI
# kimligiyle eslesir. Ama vmwgfx probe'un ILK isi olarak firmware
# framebuffer'ini devre disi birakir, uyumluluk kontrolunu SONRA yapar -
# ve VirtualBox'ta o kontrol her zaman basarisiz olur.
#
# Sonuc: firmware fb yok edilmis, yerine hicbir sey konmamis, /dev/fb0 yok,
# panel acilmiyor.
#
# simpledrm ise firmware'in kurdugu framebuffer'i oldugu gibi devralir ve
# scripts/lib/display.sh'in tasarimiyla (GRUB gfxmode + gfxpayload=keep)
# tam uyumludur. vboxvideo kalabilir: o once eslesme kontrolu yapar, bu
# yuzden zararsizdir.
# CONFIG_DRM_VMWGFX is not set
